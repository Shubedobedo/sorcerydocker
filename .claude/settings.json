{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run db:generate)",
      "Bash(npx prettier:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm ls:*)",
      "Bash(rm -r .playwright-mcp)",
      "Bash(rm -r .playwright-mcp/:*)",
      "Bash(rm .playwright-mcp/:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
